<mujoco model="capleg_rig">
  <!-- CapLeg on a treadmill hip simulator. GENERATED by tools/build_sim_models.py from the Fusion 360 export.
       Frames: +X anterior (walking direction), +Y medial (right leg), +Z up.
       Joints: rig_x (belt progression, position servo), rig_z (vertical hip, force), hip (thigh angle, position servo),
               knee / ankle_pitch (torque: AK80-9 + capstan, with reflected rotor inertia), ankle_roll (TPU springs),
               toe (MTP torsion springs), PEA = unilateral parallel spring on ankle dorsiflexion (tendon dead-band). -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" cone="elliptic" impratio="5"/>
  <size memory="20M"/>
  <visual>
    <global offwidth="1280" offheight="960" azimuth="-90" elevation="-8"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.6 0.6 0.6"/>
  </visual>
  <default>
    <default class="visual"><geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/></default>
    <default class="collision"><geom contype="1" conaffinity="0" group="3" condim="3" friction="1.0 0.02 0.002"
        solref="0.006 1" solimp="0.9 0.95 0.001" rgba="0.2 0.6 1 0.4"/></default>
    <default class="nocontact"><geom contype="0" conaffinity="0" group="3" rgba="0.2 0.6 1 0.2"/></default>
  </default>
  <asset>
    <texture name="belt" type="2d" builtin="checker" rgb1="0.16 0.16 0.17" rgb2="0.22 0.22 0.23" width="512" height="512"/>
    <material name="belt" texture="belt" texrepeat="20 20" reflectance="0.02"/>
    <material name="accent_red" rgba="0.827 0.173 0.196 1" specular="0.3" shininess="0.4"/>
    <material name="graphite" rgba="0.16 0.16 0.17 1" specular="0.3" shininess="0.4"/>
    <material name="smoke_clear" rgba="0.55 0.57 0.6 0.55" specular="0.3" shininess="0.4"/>
    <material name="aluminium" rgba="0.77 0.78 0.79 1" specular="0.3" shininess="0.4"/>
    <material name="steel" rgba="0.65 0.66 0.67 1" specular="0.3" shininess="0.4"/>
    <material name="actuator_black" rgba="0.09 0.09 0.1 1" specular="0.3" shininess="0.4"/>
    <material name="tpu_black" rgba="0.07 0.07 0.07 1" specular="0.3" shininess="0.4"/>
    <material name="cable_white" rgba="0.92 0.92 0.89 1" specular="0.3" shininess="0.4"/>
    <material name="pcb_green" rgba="0.1 0.28 0.18 1" specular="0.3" shininess="0.4"/>
    <mesh name="capleg_ankle_module__accent_red" file="capleg_ankle_module__accent_red.stl"/>
    <mesh name="capleg_ankle_module__actuator_black" file="capleg_ankle_module__actuator_black.stl"/>
    <mesh name="capleg_ankle_module__aluminium" file="capleg_ankle_module__aluminium.stl"/>
    <mesh name="capleg_ankle_module__cable_white" file="capleg_ankle_module__cable_white.stl"/>
    <mesh name="capleg_ankle_module__graphite" file="capleg_ankle_module__graphite.stl"/>
    <mesh name="capleg_ankle_module__steel" file="capleg_ankle_module__steel.stl"/>
    <mesh name="capleg_foot__accent_red" file="capleg_foot__accent_red.stl"/>
    <mesh name="capleg_foot__graphite" file="capleg_foot__graphite.stl"/>
    <mesh name="capleg_foot__steel" file="capleg_foot__steel.stl"/>
    <mesh name="capleg_foot__tpu_black" file="capleg_foot__tpu_black.stl"/>
    <mesh name="capleg_shank_knee__accent_red" file="capleg_shank_knee__accent_red.stl"/>
    <mesh name="capleg_shank_knee__actuator_black" file="capleg_shank_knee__actuator_black.stl"/>
    <mesh name="capleg_shank_knee__aluminium" file="capleg_shank_knee__aluminium.stl"/>
    <mesh name="capleg_shank_knee__cable_white" file="capleg_shank_knee__cable_white.stl"/>
    <mesh name="capleg_shank_knee__graphite" file="capleg_shank_knee__graphite.stl"/>
    <mesh name="capleg_shank_knee__pcb_green" file="capleg_shank_knee__pcb_green.stl"/>
    <mesh name="capleg_shank_knee__steel" file="capleg_shank_knee__steel.stl"/>
    <mesh name="capleg_shank_pylon__aluminium" file="capleg_shank_pylon__aluminium.stl"/>
    <mesh name="capleg_talus__aluminium" file="capleg_talus__aluminium.stl"/>
    <mesh name="capleg_talus__graphite" file="capleg_talus__graphite.stl"/>
    <mesh name="capleg_talus__steel" file="capleg_talus__steel.stl"/>
    <mesh name="capleg_thigh__aluminium" file="capleg_thigh__aluminium.stl"/>
    <mesh name="capleg_thigh__graphite" file="capleg_thigh__graphite.stl"/>
    <mesh name="capleg_thigh__smoke_clear" file="capleg_thigh__smoke_clear.stl"/>
    <mesh name="capleg_thigh__steel" file="capleg_thigh__steel.stl"/>
    <mesh name="capleg_toe__graphite" file="capleg_toe__graphite.stl"/>
    <mesh name="capleg_toe__tpu_black" file="capleg_toe__tpu_black.stl"/>
  </asset>
  <worldbody>
    <light name="key" pos="0.5 -2.0 3.0" dir="-0.2 0.7 -1" diffuse="0.8 0.8 0.8" castshadow="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="belt" contype="0" conaffinity="1" friction="1.0 0.02 0.002"/>
    <body name="rig_carriage_x">
      <joint name="rig_x" type="slide" axis="1 0 0" range="-5 500"/>
      <inertial pos="0 0 0.94" mass="5" diaginertia="0.1 0.1 0.1"/>
      <body name="rig_hip_carriage" pos="0 0 0.94">
        <joint name="rig_z" type="slide" axis="0 0 1" range="-0.25 0.10"/>
        <inertial pos="0 0 0" mass="2" diaginertia="0.01 0.01 0.01"/>
        <geom class="visual" type="box" size="0.04 0.08 0.02" material="graphite"/>
        <body name="capleg_thigh">
          <joint name="hip" type="hinge" axis="0 -1 0" range="-0.6 0.9"/>
          <inertial pos="0.000277346 0.00328051 -0.308919" mass="1.15949" fullinertia="0.0197502 0.0199917 0.00221088 4.39148e-06 -9.15477e-06 0.000986456"/>
          <geom class="visual" mesh="capleg_thigh__aluminium" material="aluminium"/>
          <geom class="visual" mesh="capleg_thigh__graphite" material="graphite"/>
          <geom class="visual" mesh="capleg_thigh__smoke_clear" material="smoke_clear"/>
          <geom class="visual" mesh="capleg_thigh__steel" material="steel"/>
          <geom class="nocontact" type="capsule" fromto="0 0 -0.06 0 0 -0.3" size="0.062"/>
          <site name="thigh_imu" pos="0 -0.02 -0.396" size="0.006" rgba="0.1 0.6 1 0.6" group="4"/>
          <body name="capleg_shank" pos="0 0 -0.43">
            <joint name="knee" type="hinge" axis="0 1 0" range="-0.0872665 2.0944"
                   armature="0.107872" damping="0.2" frictionloss="0.8"/>
            <inertial pos="-0.00216551 -0.000255995 -0.0961228" mass="1.37447" fullinertia="0.00712062 0.00746095 0.00189131 -8.98504e-05 9.62482e-05 8.08815e-05"/>
            <geom class="visual" mesh="capleg_shank_knee__accent_red" material="accent_red"/>
            <geom class="visual" mesh="capleg_shank_knee__actuator_black" material="actuator_black"/>
            <geom class="visual" mesh="capleg_shank_knee__aluminium" material="aluminium"/>
            <geom class="visual" mesh="capleg_shank_knee__cable_white" material="cable_white"/>
            <geom class="visual" mesh="capleg_shank_knee__graphite" material="graphite"/>
            <geom class="visual" mesh="capleg_shank_knee__pcb_green" material="pcb_green"/>
            <geom class="visual" mesh="capleg_shank_knee__steel" material="steel"/>
            <geom class="visual" mesh="capleg_shank_pylon__aluminium" material="aluminium"/>
            <geom class="nocontact" type="capsule" fromto="-0.006 0 -0.04 -0.006 0 -0.165" size="0.058"/>
            <site name="shank_imu" pos="0.03 0.019 -0.13" size="0.006" rgba="0.1 0.6 1 0.6" group="4"/>
            <body name="capleg_ankle_module" pos="0 0 -0.303">
              <inertial pos="-0.0392061 -0.00586419 -0.0537836" mass="1.21217" fullinertia="0.00277873 0.00395443 0.00260406 9.89576e-05 0.000137555 -0.000269649"/>
              <geom class="visual" mesh="capleg_ankle_module__accent_red" material="accent_red"/>
              <geom class="visual" mesh="capleg_ankle_module__actuator_black" material="actuator_black"/>
              <geom class="visual" mesh="capleg_ankle_module__aluminium" material="aluminium"/>
              <geom class="visual" mesh="capleg_ankle_module__cable_white" material="cable_white"/>
              <geom class="visual" mesh="capleg_ankle_module__graphite" material="graphite"/>
              <geom class="visual" mesh="capleg_ankle_module__steel" material="steel"/>
              <geom class="nocontact" type="capsule" fromto="-0.02 0 -0.04 -0.06 0 -0.075" size="0.05"/>
              <site name="load_cell" pos="0 0 0" size="0.006" rgba="0.1 0.6 1 0.6" group="4"/>
              <body name="capleg_talus" pos="0 0 -0.117">
                <joint name="ankle_pitch" type="hinge" axis="0 -1 0" range="-0.349066 0.261799"
                       armature="0.127014" damping="0.2" frictionloss="0.8"/>
                <inertial pos="-0.00869981 0.00798306 0.00319758" mass="0.406916" fullinertia="0.000425524 0.000517819 0.000343039 4.00308e-05 1.81778e-06 -6.08975e-05"/>
                <geom class="visual" mesh="capleg_talus__aluminium" material="aluminium"/>
                <geom class="visual" mesh="capleg_talus__graphite" material="graphite"/>
                <geom class="visual" mesh="capleg_talus__steel" material="steel"/>
                <body name="capleg_foot" pos="0 0 -0.044">
                  <joint name="ankle_roll" type="hinge" axis="1 0 0" range="-0.174533 0.174533"
                         stiffness="120" springref="0" damping="0.5" frictionloss="0.05"/>
                  <inertial pos="0.0263287 -0.000351722 -0.0279072" mass="0.27316" fullinertia="0.000161826 0.000716938 0.000753185 -4.11363e-06 5.82838e-05 -4.17041e-07"/>
                  <geom class="visual" mesh="capleg_foot__accent_red" material="accent_red"/>
                  <geom class="visual" mesh="capleg_foot__graphite" material="graphite"/>
                  <geom class="visual" mesh="capleg_foot__steel" material="steel"/>
                  <geom class="visual" mesh="capleg_foot__tpu_black" material="tpu_black"/>
                  <geom class="collision" type="sphere" pos="-0.052 0.018 -0.028" size="0.018"/>
                  <geom class="collision" type="sphere" pos="-0.052 -0.018 -0.028" size="0.018"/>
                  <geom class="collision" type="sphere" pos="0.104 0.03 -0.034" size="0.012"/>
                  <geom class="collision" type="sphere" pos="0.104 -0.026 -0.034" size="0.012"/>
                  <geom class="collision" type="sphere" pos="0.03 -0.03 -0.036" size="0.01"/>
                  <site name="foot_imu" pos="0.04 0 -0.031" size="0.006" rgba="0.1 0.6 1 0.6" group="4"/>
                  <site name="heel" pos="-0.052 0 -0.046" size="0.006" rgba="0.1 0.6 1 0.6" group="4"/>
                  <site name="ball" pos="0.104 0 -0.046" size="0.006" rgba="0.1 0.6 1 0.6" group="4"/>
                  <body name="capleg_toe" pos="0.12 0 -0.0345">
                    <joint name="toe" type="hinge" axis="0 -1 0" range="0 0.698132"
                           stiffness="45" springref="0" damping="0.05" frictionloss="0.02"/>
                    <inertial pos="0.0326931 0.00354203 -0.00382029" mass="0.0653597" fullinertia="3.35e-05 2.57859e-05 5.71212e-05 -1.72005e-06 2.69176e-07 5.28456e-08"/>
                    <geom class="visual" mesh="capleg_toe__graphite" material="graphite"/>
                    <geom class="visual" mesh="capleg_toe__tpu_black" material="tpu_black"/>
                    <geom class="collision" type="sphere" pos="0.03 0.022 -0.0025" size="0.009"/>
                    <geom class="collision" type="sphere" pos="0.03 -0.02 -0.0025" size="0.009"/>
                    <geom class="collision" type="sphere" pos="0.06 0.012 -0.0025" size="0.009"/>
                    <site name="toe_tip" pos="0.07 0 -0.0115" size="0.006" rgba="0.1 0.6 1 0.6" group="4"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <tendon>
    <!-- unilateral parallel-elastic actuator (PEA): springs back only when dorsiflexed beyond 0.0 rad -->
    <fixed name="pea" stiffness="250" springlength="-10 0">
      <joint joint="ankle_pitch" coef="1"/>
    </fixed>
  </tendon>
  <contact>
    <exclude body1="capleg_foot" body2="capleg_toe"/>
  </contact>
  <actuator>
    <!-- rig axes are force/torque driven; set-points + PD gains live in capleg_control.core.controller.RigController -->
    <motor name="rig_x" joint="rig_x" ctrlrange="-8000 8000"/>
    <motor name="rig_z" joint="rig_z" ctrlrange="-3000 3000"/>
    <motor name="hip" joint="hip" ctrlrange="-800 800"/>
    <motor name="knee" joint="knee" ctrlrange="-102.345 102.345"/>
    <motor name="ankle" joint="ankle_pitch" ctrlrange="-111.055 111.055"/>
  </actuator>
  <sensor>
    <jointpos name="q_hip" joint="hip"/>
    <jointpos name="q_knee" joint="knee"/>
    <jointpos name="q_ankle" joint="ankle_pitch"/>
    <jointpos name="q_roll" joint="ankle_roll"/>
    <jointpos name="q_toe" joint="toe"/>
    <jointvel name="qd_hip" joint="hip"/>
    <jointvel name="qd_knee" joint="knee"/>
    <jointvel name="qd_ankle" joint="ankle_pitch"/>
    <actuatorfrc name="tau_knee" actuator="knee"/>
    <actuatorfrc name="tau_ankle" actuator="ankle"/>
    <force name="load_cell_force" site="load_cell"/>
    <torque name="load_cell_torque" site="load_cell"/>
    <gyro name="thigh_gyro" site="thigh_imu"/>
    <accelerometer name="thigh_acc" site="thigh_imu"/>
    <gyro name="shank_gyro" site="shank_imu"/>
    <accelerometer name="shank_acc" site="shank_imu"/>
    <gyro name="foot_gyro" site="foot_imu"/>
    <accelerometer name="foot_acc" site="foot_imu"/>
  </sensor>
</mujoco>
