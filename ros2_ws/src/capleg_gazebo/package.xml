<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>capleg_gazebo</name>
  <version>1.0.0</version>
  <description>
    Gazebo Harmonic treadmill hip simulator for the CapLeg powered prosthesis: world, ros2_control controller
    configuration and launch files (ROS 2 Jazzy).
  </description>
  <maintainer email="m.a.basar.mte@gmail.com">Md. Abul Basar Roky</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/Basar-mte/CapLeg</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>capleg_description</exec_depend>
  <exec_depend>capleg_control</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
