<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>capleg_description</name>
  <version>1.0.0</version>
  <description>
    Robot description of CapLeg, a capstan-driven powered transfemoral prosthesis (research platform):
    xacro/URDF generated from the Fusion 360 model, meshes, ros2_control + Gazebo Harmonic extensions,
    treadmill hip-simulator rig and an RViz viewer.
  </description>
  <maintainer email="m.a.basar.mte@gmail.com">Md. Abul Basar Roky</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/Basar-mte/CapLeg</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
